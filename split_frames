import imageio.v3 as iio
from pathlib import Path

def extract_frames(input_path: Path, output_dir: Path, img_format="png", start=0, step=1, pad=6):
    output_dir.mkdir(parents=True, exist_ok=True)
    reader = iio.imiter(input_path)
    written = 0

    for idx, frame in enumerate(reader):
        if idx < start or (idx - start) % step != 0:
            continue
        frame_path = output_dir / f"frame_{written:0{pad}d}.{img_format}"
        iio.imwrite(frame_path, frame)
        written += 1

    return written, idx + 1

